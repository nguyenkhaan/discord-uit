# Local setup
PORT=5050
HOST=localhost
DATABASE_URL=
# KAFKA
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=document-classification-ai-v1
KAFKA_REQUESTED_TOPIC=document.classification.requested.v1
KAFKA_COMPLETED_TOPIC=document.classification.completed.v1
KAFKA_FAILED_TOPIC=document.classification.failed.v1
KAFKA_DLQ_TOPIC=document.classification.dlq.v1

SERVICE_ID=ai-classification-worker
JOB_LEASE_SECONDS=300
KAFKA_REQUEST_TIMEOUT_MS=10000
MAX_KAFKA_EVENT_BYTES=1048576
WORKER_PROCESSING_ATTEMPTS=3
WORKER_RETRY_BACKOFF_MS=500
DOCUMENT_URL_ALLOWED_HOSTS=localhost:9000,127.0.0.1:9000,minio:9000
DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=30
# OCR
OCR_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=10485760
MAX_OCR_PAGES=20
OCR_RENDER_DPI=200
OCR_CPU_THREADS=2
OCR_LANGUAGES=eng+vie
TESSERACT_COMMAND=tesseract
MAX_OCR_PIXELS_PER_PAGE=20000000
MAX_PDF_PAGES=100
MAX_ARCHIVE_EXPANDED_BYTES=50000000
MAX_EXTRACTED_TEXT_CHARS=200000
PDF_MIN_ALNUM_CHARS_PER_PAGE=40
PDF_MIN_ALNUM_RATIO=0.5

# Final-classification LLM: groq or openrouter
LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=60
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Embedding model
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
CACHE_PATH=cache/catalogue_embeddings.json
