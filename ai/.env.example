# Local server
PORT=5050

# Google Gemini embedding provider
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Final-classification LLM
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Local processing
MAX_UPLOAD_BYTES=10485760
MAX_OCR_PAGES=10
OCR_RENDER_DPI=200
OCR_CPU_THREADS=2
MAX_OCR_PIXELS_PER_PAGE=20000000
MAX_PDF_PAGES=100
CACHE_PATH=cache/catalogue_embeddings.json
